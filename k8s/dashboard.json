{
  "uid": "sentiment-lab",
  "title": "Sentiment API · Kubernetes",
  "tags": [
    "sentiment",
    "kubernetes"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Запросы к API",
      "description": "Все статусы ответа",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 9
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "placement": "bottom",
          "displayMode": "list"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{namespace=\"sentiment\",uri=\"/api/sentiment\"}[1m]))",
          "legendFormat": "Запросы к API"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Задержка p95",
      "description": "95-й перцентиль времени HTTP-ответа",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 9
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "placement": "bottom",
          "displayMode": "list"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1000 * histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{namespace=\"sentiment\",uri=\"/api/sentiment\"}[1m])))",
          "legendFormat": "Задержка p95"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "CPU на под",
      "description": "Загрузка CPU cgroup пода в процентах от запроса контейнера. Для HPA источник — Metrics Server.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 9
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "placement": "bottom",
          "displayMode": "list"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"sentiment\",pod!=\"\",id=~\".*/pod[^/]+|.*/[^/]*-pod[^/]+[.]slice\"}[1m])) / sum by (pod) (kube_pod_container_resource_requests{namespace=\"sentiment\",container=\"sentiment\",resource=\"cpu\",unit=\"core\"})",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Реплики HPA",
      "description": "Фактические и целевые реплики",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 9
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "placement": "bottom",
          "displayMode": "list"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"sentiment\",horizontalpodautoscaler=\"sentiment\"}",
          "legendFormat": "Фактические"
        },
        {
          "refId": "B",
          "expr": "kube_horizontalpodautoscaler_status_desired_replicas{namespace=\"sentiment\",horizontalpodautoscaler=\"sentiment\"}",
          "legendFormat": "Целевые"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Предсказания по классам",
      "description": "Классы модели с ограниченной кардинальностью",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 9
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "placement": "bottom",
          "displayMode": "list"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (label) (rate(sentiment_predictions_total{namespace=\"sentiment\"}[1m]))",
          "legendFormat": "{{label}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Готовые цели Prometheus",
      "description": "Число успешно опрашиваемых реплик",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 9
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "placement": "bottom",
          "displayMode": "list"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{namespace=\"sentiment\",service=\"sentiment-metrics\"})",
          "legendFormat": "Готовые цели Prometheus"
        }
      ]
    }
  ]
}
